      "parameters": {
        "kernel": 3
      },
      "position": [
        570,
        310
      ],
      "exposed_inputs": [
        "image",
        "mask",
        "region"
      ],
      "exposed_outputs": [
        "image"
      ],
      "thumbnail": true,
      "preview_output": ""
    },
    {
      "id": "starter_threshold",
      "type": "cv.auto_threshold",
      "name": "Segment parts",
      "parameters": {
        "method": "otsu",
        "invert": false,
        "max_value": -1.0
      },
      "position": [
        285,
        310
      ],
      "exposed_inputs": [
        "image",
        "mask",
        "region"
      ],
      "exposed_outputs": [
        "image",
        "threshold"
      ],
      "thumbnail": true,
      "preview_output": ""
    },
    {
      "id": "starter_morphology",
      "type": "cv.morphology",
      "name": "Clean mask",
      "parameters": {
        "operation": "close",
        "shape": "ellipse",
        "kernel": 5,
        "iterations": 1,
        "kernel_y": 0,
        "anchor": [
          -1,
          -1
        ],
        "shape_anchor": [
          -1,
          -1
        ],
        "border": "constant",
        "border_value": []
      },
      "position": [
        0,
        310
      ],
      "exposed_inputs": [
        "image",
        "mask",
        "region"
      ],
      "exposed_outputs": [
        "image"
      ],
      "thumbnail": true,
      "preview_output": ""
    },
    {
      "id": "starter_components",
      "type": "inspect.components",
      "name": "Measure the PCB foreground",
      "parameters": {
        "connectivity": 8,
        "min_area": 5000,
        "max_area": 0,
        "expected_count": 1,
        "algorithm": "default",
        "region_mode": "center"
