      "position": [
        570,
        620
      ],
      "exposed_inputs": [
        "image",
        "mask",
        "region"
      ],
      "exposed_outputs": [
        "histogram",
        "plot"
      ],
      "thumbnail": true,
      "preview_output": ""
    },
