      "id": "starter_edges",
      "type": "cv.canny",
      "name": "Part edges",
      "parameters": {
        "low": 40.0,
        "high": 120.0,
        "aperture": "3",
        "l2_gradient": false
      },
      "position": [
        285,
        620
      ],
      "exposed_inputs": [
        "image",
        "mask",
        "region"
      ],
      "exposed_outputs": [
        "image"
      ],
      "thumbnail": true,
      "preview_output": ""
    },
    {
