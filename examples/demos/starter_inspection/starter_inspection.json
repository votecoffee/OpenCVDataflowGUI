      "name": "Inspection ROI",
      "parameters": {
        "x": 60,
        "y": 45,
        "width": 325,
        "height": 195
      },
      "position": [
        285,
        0
      ],
      "exposed_inputs": [
        "image"
      ],
      "exposed_outputs": [
        "image",
        "geometry"
      ],
      "thumbnail": true,
      "preview_output": ""
    },
    {
      "id": "starter_gray",
