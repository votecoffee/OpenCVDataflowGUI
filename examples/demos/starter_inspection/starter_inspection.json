      "position": [
        0,
        620
      ],
      "exposed_inputs": [
        "image",
        "mask",
        "region"
      ],
      "exposed_outputs": [
        "overlay",
        "mask",
        "count",
        "centroids",
        "data",
        "collection"
      ],
      "thumbnail": true,
      "preview_output": "overlay"
    },
    {
      "id": "starter_histogram",
      "type": "inspect.histogram",
