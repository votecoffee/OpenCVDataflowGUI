      "type": "layout.comment",
      "name": "Real data: source and scope",
      "parameters": {},
      "position": [
        0,
        -680
      ],
      "exposed_inputs": [],
      "exposed_outputs": [],
      "thumbnail": true,
      "preview_output": "",
      "description": "VisA, CC BY 4.0. Yang Zou, Jongheon Jeong, Latha Pemula, Dongqing Zhang, Onkar Dabeer; SPot-the-Difference, ECCV 2022. registry.opendata.aws/visa/. Resized/letterboxed for this example; no defects were added. Thresholded regions illustrate graph editing and overlays. No calibrated defect labels are supplied.",
      "node_size": "large"
    }
