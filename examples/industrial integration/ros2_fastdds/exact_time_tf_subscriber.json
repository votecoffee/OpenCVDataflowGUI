    {
      "id": "source_and_scope",
      "type": "layout.comment",
      "name": "Source, setup and scope",
      "description": "Disabled exact-time TF template. Enable only an isolated configured ROS domain. The camera header supplies nonzero acquisition time/source frame; Target is base_link. Start the persistent TF listener before dynamic captures. No latest fallback exists. Default node-clock freshness is one second; select Use sim time and the correct clock for simulated headers. Observed backward clock jumps invalidate the listener until reset or a new validated run context. Static lookup stamps are query times, not measurements. Pose is base_link_from_camera in meters. Nothing publishes robot motion.",
      "parameters": {},
      "position": [
        0,
        -300
      ],
      "node_size": "large",
      "exposed_inputs": [],
      "exposed_outputs": [],
      "thumbnail": true,
      "preview_output": ""
