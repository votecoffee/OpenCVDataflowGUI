    {
      "id": "source_and_scope",
      "type": "layout.comment",
      "name": "Source, setup and scope",
      "description": "Disabled approximate RGB-D template: ordered FIFO pairing within 5 ms, then static CameraInfo binding to the matched depth, exact ticket coordination, registered RGB-D validation and a colored meter cloud. Declared common ROS clock is not verified clock synchronization. Original image stamps remain intact; common pair tickets preserve original ticket provenance. Prime calibration before images. Expiry is cooperative; duplicate stamps are ignored and backward stamps hold until reset/new run context. All live endpoints remain disabled. No simulator or robot is started.",
      "parameters": {},
      "position": [
        0,
        -300
      ],
      "node_size": "large",
      "exposed_inputs": [],
      "exposed_outputs": [],
      "thumbnail": true,
      "preview_output": ""
    },
