{
  "schema_version": 1,
  "groups": [
    {
      "id": "image_input",
      "name": "Image sequence",
      "members": [
        "validation_source"
      ]
    },
    {
      "id": "inspection",
      "name": "One part inspection",
      "members": [
        "validation_inspect",
        "validation_final"
      ]
    }
  ],
  "validation_sets": [
    {
      "id": "validation_smoke",
      "name": "One-part regression",
      "source": "validation_source",
      "judgment": "validation_final",
      "state_mode": "isolated",
      "allow_outputs": false,
      "cases": [
        {
          "id": "known_pass",
          "path": "../../assets/validation/pass.png",
          "expectation": "must_pass"
        },
        {
          "id": "known_fail",
          "path": "../../assets/validation/fail.png",
          "expectation": "must_fail",
          "preferred_fail_reason": "part_count"
        },
        {
          "id": "likely_pass",
          "path": "../../assets/validation/pass.png",
          "expectation": "should_pass"
        },
        {
          "id": "likely_fail",
          "path": "../../assets/validation/fail.png",
          "expectation": "should_fail",
          "preferred_fail_reason": "part_count"
        },
        {
          "id": "unclassified",
          "path": "../../assets/validation/unknown.png",
          "expectation": "unknown"
        }
      ]
    }
  ],
  "blocks": [
    {
      "id": "validation_source",
      "type": "input.file",
      "name": "Image file",
      "parameters": {
        "path": "../../assets/validation/pass.png",
        "source_mode": "files",
        "paths": [
          "../../assets/validation/pass.png",
          "../../assets/validation/fail.png",
          "../../assets/validation/unknown.png"
        ],
        "directory": "",
        "recursive": false,
        "repeat": "stop",
        "filename_ticket": true,
        "color_format": "bgr",
        "pixel_depth": "uint8",
        "path_base": "project"
      },
      "position": [
        0,
        0
      ],
      "exposed_inputs": [
        "ticket"
      ],
      "exposed_outputs": [
        "image",
        "info",
        "ticket"
      ],
      "thumbnail": true,
      "preview_output": ""
    },
    {
      "id": "validation_inspect",
      "type": "inspect.contours",
      "name": "Find contours",
      "parameters": {
        "min_area": 20.0,
        "expected_count": 1,
        "retrieval": "external",
        "approximation": "simple",
        "offset": [
          0,
          0
        ],
        "region_mode": "center"
      },
      "position": [
        340,
        0
      ],
      "exposed_inputs": [
        "image",
        "mask",
        "region"
      ],
      "exposed_outputs": [
        "overlay",
        "mask",
        "count",
        "data",
        "collection"
      ],
      "thumbnail": true,
      "preview_output": ""
    },
    {
      "id": "validation_final",
      "type": "inspect.final_judgment",
      "name": "Final ticket judgment",
      "parameters": {
        "mode": "upstream",
        "data": {},
        "fail_reason": "part_count",
        "reason_message": "Expected exactly one part"
      },
      "position": [
        680,
        0
      ],
      "exposed_inputs": [
        "value",
        "passed",
        "reasons"
      ],
      "exposed_outputs": [
        "value",
        "judgment"
      ],
      "thumbnail": true,
      "preview_output": ""
    }
  ],
  "connections": [
    {
      "source": "validation_source",
      "output": "image",
      "target": "validation_inspect",
      "input": "image"
    },
    {
      "source": "validation_inspect",
      "output": "overlay",
      "target": "validation_final",
      "input": "value"
    }
  ]
}
