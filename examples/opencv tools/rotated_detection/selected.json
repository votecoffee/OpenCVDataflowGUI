    {
      "id": "attribution",
      "type": "layout.comment",
      "name": "Original rotated controls - MIT",
      "description": "Original MIT images, ONNX controls, graphs and analytic geometry by OpenCVDataflowGUI contributors. Fixed oriented proposals use RGB image means for scores; no trained recognition or customer/third-party data. Default polygon IoU preserves small contained parts; this build's native NMS suppresses them. Crossing thin rectangles test oriented overlap. Exact source polygons/affine poses retain non-uniform resize. Count-failure and empty projects intentionally fail inspection while retaining current outputs. See README/truth.json.",
      "parameters": {},
      "position": [
        0,
        -500
      ],
      "node_size": "large",
      "exposed_inputs": [],
      "exposed_outputs": [],
      "thumbnail": true,
      "preview_output": ""
