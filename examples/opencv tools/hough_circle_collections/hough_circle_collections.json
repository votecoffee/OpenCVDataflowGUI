{
  "schema_version": 1,
  "blocks": [
    {
      "id": "source",
      "type": "input.file",
      "name": "Synthetic disks",
      "parameters": {"path": "assets/disks.png", "path_base": "project", "color_format": "gray"},
      "position": [0, 0],
      "exposed_inputs": [],
      "exposed_outputs": ["image"],
      "thumbnail": true
    },
    {
      "id": "circles",
      "type": "inspect.hough_circles",
      "name": "Find circles and read votes",
      "parameters": {
        "dp": 1.0, "min_distance": 40.0, "center_threshold": 22.0,
        "min_radius": 15, "max_radius": 36
      },
      "position": [320, 200],
      "exposed_inputs": ["image"],
      "exposed_outputs": ["collection", "votes", "circles", "overlay"],
      "thumbnail": true
    },
    {
      "id": "sort",
      "type": "collection.sort",
      "name": "Rank by native votes",
      "parameters": {"metric": "strength", "direction": "descending"},
      "position": [640, 200],
      "exposed_inputs": ["collection"],
      "exposed_outputs": ["collection"]
    },
    {
      "id": "filter",
      "type": "collection.filter",
      "name": "Keep radius 24 px or greater",
      "parameters": {"metric": "radius", "minimum": 24.0},
      "position": [960, 400],
      "exposed_inputs": ["collection"],
      "exposed_outputs": ["collection", "count", "rejected_count"]
    },
    {
      "id": "ranked",
      "type": "collection.draw",
      "name": "Show ranked circles",
      "parameters": {"draw_bounds": false, "draw_centers": false},
      "position": [1280, 0],
      "exposed_inputs": ["image", "collection"],
      "exposed_outputs": ["overlay", "count"],
      "thumbnail": true,
      "preview_output": "overlay"
    },
    {
      "id": "selected",
      "type": "collection.draw",
      "name": "Draw and mask larger disk",
      "parameters": {"draw_bounds": false, "draw_centers": false, "labels": "none"},
      "position": [1280, 400],
      "exposed_inputs": ["image", "collection"],
      "exposed_outputs": ["overlay", "mask", "count"],
      "thumbnail": true,
      "preview_output": "overlay"
    }
  ],
  "connections": [
    {"source": "source", "output": "image", "target": "circles", "input": "image"},
    {"source": "circles", "output": "collection", "target": "sort", "input": "collection"},
    {"source": "sort", "output": "collection", "target": "filter", "input": "collection"},
    {"source": "source", "output": "image", "target": "ranked", "input": "image"},
    {"source": "sort", "output": "collection", "target": "ranked", "input": "collection"},
    {"source": "source", "output": "image", "target": "selected", "input": "image"},
    {"source": "filter", "output": "collection", "target": "selected", "input": "collection"}
  ]
}
