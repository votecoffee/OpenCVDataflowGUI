{
  "schema_version": 1,
  "blocks": [
    {
      "id": "video",
      "type": "input.video_file",
      "name": "Video file",
      "parameters": {
        "path": "assets/variable.mkv",
        "path_base": "project",
        "backend": "ffmpeg",
        "start_frame": 0,
        "end_frame": -1,
        "stride": 1,
        "repeat": "stop",
        "frame_ticket": true,
        "color_format": "bgr",
        "pixel_depth": "uint8"
      },
      "position": [
        0,
        0
      ],
      "node_size": "large",
      "exposed_inputs": [
        "ticket"
      ],
      "exposed_outputs": [
        "image",
        "info",
        "ticket"
      ],
      "thumbnail": true,
      "preview_output": ""
    },
    {
      "id": "timing",
      "type": "sequence.video_timing",
      "name": "Video timing monitor",
      "description": "Observe video clocks without silently repairing them.",
      "documentation": "<p>Checks current raw/effective time, index order, cadence and optional independent references. Variable rate is valid by default. Reset explicitly across loops. See docs/video-timing.md for scope, labels, retention and acceptance limits.</p>",
      "parameters": {
        "warmup": 1,
        "max_streams": 4,
        "max_bytes_mb": 128.0,
        "overflow": "error",
        "context_change": "reset",
        "max_gap_ms": 0.0,
        "history_size": 256,
        "timestamp_policy": "decoder_only",
        "cadence_policy": "allow_variable",
        "absolute_tolerance_ms": 1.0,
        "relative_tolerance_percent": 5.0,
        "maximum_interval_ms": 0.0,
        "latch_failures": true,
        "reference_timestamps_ms": [
          0,
          40,
          130,
          160,
          340,
          380,
          550,
          600
        ],
        "reference_tolerance_ms": 1.0
      },
      "position": [
        380,
        0
      ],
      "node_size": "large",
      "exposed_inputs": [
        "image",
        "info",
        "reference",
        "reset",
        "stream"
      ],
      "exposed_outputs": [
        "image",
        "report",
        "ok",
        "variable_rate",
        "ready",
        "activations",
        "status",
        "chart",
        "result_graphics"
      ],
      "thumbnail": true,
      "preview_output": ""
    },
    {
      "id": "gray",
      "type": "cv.gray",
      "name": "Grayscale",
      "parameters": {
        "algorithm_hint": "default"
      },
      "position": [
        760,
        200
      ],
      "exposed_inputs": [
        "image"
      ],
      "exposed_outputs": [
        "image"
      ],
      "thumbnail": true,
      "preview_output": ""
    },
    {
      "id": "threshold",
      "type": "cv.threshold",
      "name": "Threshold",
      "parameters": {
        "value": 127.0,
        "invert": false,
        "max_value": 255.0,
        "mode": "binary"
      },
      "position": [
        1140,
        200
      ],
      "exposed_inputs": [
        "image",
        "mask",
        "region"
      ],
      "exposed_outputs": [
        "image",
        "threshold"
      ],
      "thumbnail": true,
      "preview_output": ""
    },
    {
      "id": "blobs",
      "type": "inspect.blobs",
      "name": "Find blobs",
      "parameters": {
        "connectivity": 8,
        "min_area": 40,
        "max_area": 0,
        "expected_count": 2,
        "algorithm": "default",
        "region_mode": "center",
        "check_count": false
      },
      "position": [
        1520,
        200
      ],
      "exposed_inputs": [
        "image",
        "mask",
        "region"
      ],
      "exposed_outputs": [
        "overlay",
        "mask",
        "count",
        "centroids",
        "data",
        "collection",
        "result_graphics"
      ],
      "thumbnail": true,
      "preview_output": ""
    },
    {
      "id": "overlay",
      "type": "cv.overlay_result_graphics",
      "name": "Overlay result graphics",
      "parameters": {
        "excluded_graphics": {}
      },
      "position": [
        1900,
        0
      ],
      "exposed_inputs": [
        "image",
        "graphics_1",
        "graphics_2"
      ],
      "exposed_outputs": [
        "image"
      ],
      "thumbnail": true,
      "preview_output": ""
    },
    {
      "id": "filmstrip",
      "type": "output.filmstrip_image",
      "name": "Set filmstrip image",
      "parameters": {
        "priority": 0
      },
      "position": [
        2280,
        0
      ],
      "exposed_inputs": [
        "image"
      ],
      "exposed_outputs": [
        "image"
      ],
      "thumbnail": true,
      "preview_output": ""
    },
    {
      "id": "attribution",
      "type": "layout.comment",
      "name": "Original authored clocks - MIT",
      "description": "Original MIT synthetic images, explicit-time Matroska fixtures, generator and projects by OpenCVDataflowGUI contributors. No customer or third-party images. Timestamps are independently specified in truth.json and encoded directly into SimpleBlock headers. Native FFmpeg reads these actual unequal/repeated/backward times. Wrong rate declares 10 FPS but stores 40 ms intervals. Zero time omits DefaultDuration and all positions are zero; legacy replay estimates remain separately visible from raw properties. Default valid-VFR policy accepts unequal positive intervals. Intentional bad clocks/reference fail without hiding the current image or repairing its timing. Paced VFR wires Cycle start to Reset. The dedicated timing chart uses its own pixel grid; selected timing/blob objects overlay the original image. Matroska format references are in README.",
      "parameters": {},
      "position": [
        0,
        -500
      ],
      "node_size": "large",
      "exposed_inputs": [],
      "exposed_outputs": [],
      "thumbnail": true,
      "preview_output": ""
    }
  ],
  "connections": [
    {
      "source": "video",
      "output": "image",
      "target": "timing",
      "input": "image"
    },
    {
      "source": "video",
      "output": "info",
      "target": "timing",
      "input": "info"
    },
    {
      "source": "timing",
      "output": "image",
      "target": "gray",
      "input": "image"
    },
    {
      "source": "gray",
      "output": "image",
      "target": "threshold",
      "input": "image"
    },
    {
      "source": "threshold",
      "output": "image",
      "target": "blobs",
      "input": "image"
    },
    {
      "source": "timing",
      "output": "image",
      "target": "overlay",
      "input": "image"
    },
    {
      "source": "timing",
      "output": "result_graphics",
      "target": "overlay",
      "input": "graphics_1"
    },
    {
      "source": "blobs",
      "output": "result_graphics",
      "target": "overlay",
      "input": "graphics_2"
    },
    {
      "source": "overlay",
      "output": "image",
      "target": "filmstrip",
      "input": "image"
    }
  ]
}
