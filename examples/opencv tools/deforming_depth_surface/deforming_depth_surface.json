{
  "schema_version": 1,
  "blocks": [
    {
      "id": "note",
      "type": "layout.comment",
      "name": "Track a bending sheet through a missing exposure",
      "description": "Original synthetic sheet recording by OpenCVDataflowGUI contributors (MIT). Run All starts a reference on pair 0. Pair 2 has a depth hole. Pair 3 has no depth, and pair 4 recovers from the original reference.",
      "parameters": {},
      "position": [
        0,
        -245
      ],
      "node_size": "large",
      "exposed_inputs": [],
      "exposed_outputs": [],
      "thumbnail": true,
      "preview_output": ""
    },
    {
      "id": "replay",
      "type": "input.rgbd_recording",
      "name": "Registered guide and depth",
      "parameters": {
        "path": "assets/recording.json",
        "repeat": "stop",
        "maximum_skew_ms": 0,
        "display_max_m": 5.0
      },
      "position": [
        0,
        0
      ],
      "exposed_inputs": [
        "ticket"
      ],
      "exposed_outputs": [
        "image",
        "depth",
        "confidence",
        "info",
        "ticket"
      ],
      "thumbnail": true,
      "preview_output": ""
    },
    {
      "id": "camera",
      "type": "3d.camera",
      "name": "Fixed pinhole camera",
      "parameters": {
        "fx": 171.0,
        "fy": 169.0,
        "cx": 71.5,
        "cy": 51.5,
        "width": 144,
        "height": 104,
        "distortion": [],
        "lens": "pinhole",
        "xi": 1.0,
        "units": "m",
        "frame": "sheet_depth_optical"
      },
      "position": [
        0,
        260
      ],
      "exposed_inputs": [
        "calibration"
      ],
      "exposed_outputs": [
        "camera"
      ],
      "thumbnail": true,
      "preview_output": ""
