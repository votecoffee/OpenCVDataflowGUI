      "type": "3d.track_deforming_surface",
      "name": "Reconstruct the visible sheet",
      "parameters": {
        "warmup": 2,
        "max_streams": 4,
        "max_bytes_mb": 128.0,
        "overflow": "error",
        "context_change": "reset",
        "max_gap_ms": 0.0,
        "tracking_window": 13,
        "max_pyramid_level": 2,
        "forward_backward_pixels": 1.0,
        "max_patch_error": 30.0,
        "correspondence": "tracked_guide",
        "input_units": "mm",
        "units_per_sample": 1.0,
        "sample_step": 4,
        "minimum_points": 20,
        "minimum_fraction": 0.7,
        "minimum_depth_m": 0.05,
        "maximum_depth_m": 5.0,
        "max_depth_span_m": 0.03,
        "max_motion_px": 36.0,
        "max_displacement_m": 0.09
      },
      "position": [
        420,
        105
      ],
      "node_size": "large",
      "exposed_inputs": [
        "image",
        "camera",
        "guide",
