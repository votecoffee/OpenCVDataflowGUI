    {
      "id": "full",
      "type": "cv.reconstruct_fourier_image",
      "name": "Reconstruct Fourier image components",
      "documentation": "<p>Reconstruct full, phase-only or zero-phase magnitude components per color channel or in grayscale. Unsigned input maps to [0,1]; floating input retains its values. Output stays floating and signed unless explicit intensity normalization is chosen. Color output has three channels; original alpha remains on Source.</p><p>Selections zero input samples before the global transform. Native inverse scaling uses the padded transform length; the result is cropped back. Magnitude-only images use a new origin-based grid, while phase/full images retain source coordinates.</p>",
      "parameters": {
        "components": "full",
        "dc": "keep",
        "relative_floor": 1e-06,
        "absolute_floor": 0.0,
        "symmetry": "require",
        "precision": "auto",
        "mode": "2d",
        "size": "exact",
        "channels": "independent",
        "normalization": "none",
        "normalization_scope": "per_channel"
      },
      "position": [
        60.0,
        0.0
      ],
      "exposed_inputs": [
        "image",
        "mask",
        "region"
      ],
      "exposed_outputs": [
        "image",
        "info"
      ],
      "thumbnail": true,
      "preview_output": ""
    },
