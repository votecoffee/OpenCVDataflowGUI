  "connections": [
    {
      "source": "estimate",
      "output": "depth",
      "target": "step_band",
      "input": "image"
    },
    {
      "source": "estimate",
      "output": "depth",
      "target": "whole",
      "input": "estimate"
    },
    {
      "source": "reference",
      "output": "depth",
      "target": "whole",
      "input": "reference"
    },
    {
      "source": "estimate",
      "output": "depth",
      "target": "step",
      "input": "estimate"
    },
    {
      "source": "reference",
      "output": "depth",
      "target": "step",
      "input": "reference"
    },
    {
      "source": "step_band",
      "output": "region",
      "target": "step",
      "input": "region"
    }
  ]
}
