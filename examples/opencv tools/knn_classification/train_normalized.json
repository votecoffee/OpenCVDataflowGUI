{
  "schema_version": 1,
  "blocks": [
    {
      "id": "source",
      "type": "input.file",
      "name": "Image file",
      "parameters": {
        "path": "",
        "source_mode": "files",
        "paths": [
          "assets/train-vertical-0.png",
          "assets/train-vertical-1.png",
          "assets/train-vertical-2.png",
          "assets/train-horizontal-0.png",
          "assets/train-horizontal-1.png",
          "assets/train-horizontal-2.png"
        ],
        "directory": "",
        "recursive": false,
        "repeat": "stop",
        "filename_ticket": true,
        "metadata_mode": "off",
        "color_format": "gray",
        "pixel_depth": "uint8",
        "path_base": "project"
      },
      "position": [
        0,
        0
      ],
      "exposed_inputs": [
        "ticket"
      ],
      "exposed_outputs": [
        "image",
        "info",
        "ticket"
      ],
      "thumbnail": true,
      "preview_output": ""
    },
    {
      "id": "hog",
      "type": "inspect.hog",
      "name": "Histogram of oriented gradients",
      "parameters": {
        "cell_size": [
          8,
          8
        ],
        "block_size": [
          16,
          16
        ],
        "block_stride": [
          8,
          8
        ],
        "bins": 9,
        "win_sigma": -1.0,
        "l2_hys_threshold": 0.2,
        "gamma_correction": true,
        "signed_gradient": false
      },
      "position": [
        360,
        0
      ],
      "exposed_inputs": [
        "image"
      ],
      "exposed_outputs": [
        "descriptor",
        "info"
      ],
      "thumbnail": true,
      "preview_output": ""
    },
    {
      "id": "batch",
      "type": "flow.batch",
      "name": "Batch serial entries",
      "parameters": {
        "size": 6,
        "distinct_sources": false,
        "max_pending": 64,
        "max_bytes_mb": 128.0
      },
      "position": [
        720,
        0
      ],
      "exposed_inputs": [
        "item_1",
        "item_2",
        "item_3",
        "item_4"
      ],
      "exposed_outputs": [
        "group",
        "queued"
      ],
      "thumbnail": true,
      "preview_output": ""
    },
    {
      "id": "train",
      "type": "ml.knn_train",
      "name": "Train OpenCV K-nearest classifier",
      "parameters": {
        "k": 3,
        "normalization": "l2",
        "labels": [
          "vertical",
          "vertical",
          "vertical",
          "horizontal",
          "horizontal",
          "horizontal"
        ]
      },
      "position": [
        1080,
        0
      ],
      "exposed_inputs": [
        "samples",
        "labels"
      ],
      "exposed_outputs": [
        "model",
        "report"
      ],
      "thumbnail": true,
      "preview_output": ""
    },
    {
      "id": "save",
      "type": "ml.knn_save",
      "name": "Save K-nearest classifier",
      "parameters": {
        "path": "trained-normalized.json"
      },
      "position": [
        1440,
        0
      ],
      "exposed_inputs": [
        "model"
      ],
      "exposed_outputs": [
        "path"
      ],
      "thumbnail": true,
      "preview_output": ""
    },
    {
      "id": "attribution",
      "type": "layout.comment",
      "name": "Original synthetic HOG / K-nearest controls",
      "description": "Original synthetic stripe images and code by OpenCVDataflowGUI contributors, MIT. Eight images copied unchanged from reusable_clusters; diagonal control is new. No external model, image or tutorial content. Training and query pixel hashes differ. Raw native votes/distances remain visible when recognition is withheld. Distance and vote agreement are not probabilities. This bounded orientation fixture is not production classification or OCR accuracy evidence. Models include the training feature rows. See README.md and SOURCES.md.",
      "parameters": {},
      "position": [
        0,
        -470
      ],
      "node_size": "large",
      "exposed_inputs": [],
      "exposed_outputs": [],
      "thumbnail": true,
      "preview_output": ""
    }
  ],
  "connections": [
    {
      "source": "source",
      "output": "image",
      "target": "hog",
      "input": "image"
    },
    {
      "source": "hog",
      "output": "descriptor",
      "target": "batch",
      "input": "item_1"
    },
    {
      "source": "batch",
      "output": "group",
      "target": "train",
      "input": "samples"
    },
    {
      "source": "train",
      "output": "model",
      "target": "save",
      "input": "model"
    }
  ]
}
