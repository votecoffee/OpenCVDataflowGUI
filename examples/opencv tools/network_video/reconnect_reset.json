{
  "schema_version": 1,
  "program": {
    "name": "Original loopback network video",
    "description": "",
    "enabled": true,
    "variables": {},
    "scripts": {
      "startup": "",
      "before_run": "",
      "after_run": "",
      "shutdown": ""
    },
    "script_timeout_seconds": 10.0,
    "services": [
      {
        "id": "mjpeg",
        "enabled": true,
        "runtime": "application",
        "argv": [
          "{python}",
          "{project_dir}/serve_stream.py",
          "--port",
          "18764"
        ],
        "cwd": "{project_dir}",
        "environment": {},
        "ready_text": "READY network-video 18764",
        "startup_timeout_seconds": 10,
        "shutdown_timeout_seconds": 2,
        "stop_input": ""
      }
    ],
    "assets": [
      "serve_stream.py",
      "assets/frame_00.jpg",
      "assets/frame_01.jpg",
      "assets/frame_02.jpg",
      "assets/frame_03.jpg",
      "assets/frame_04.jpg",
      "assets/frame_05.jpg",
      "assets/frame_06.jpg",
      "assets/frame_07.jpg"
    ]
  },
  "blocks": [
    {
      "id": "video",
      "type": "input.network_video",
      "name": "Network video",
      "description": "Read a live stream with bounded recovery and Stop.",
      "documentation": "<p>One frame per activation; no application read-ahead. Reconnection and Stop/Resume open a new segment and publish Stream start. See docs/network-video.md for deadlines, timestamp provenance, buffering, credentials and resource limits.</p>",
      "parameters": {
        "url": "http://127.0.0.1:18764/drop",
        "source_name": "original-loopback",
        "backend": "ffmpeg",
        "rtsp_transport": "tcp",
        "startup_timeout_ms": 5000,
        "open_timeout_ms": 2000,
        "read_timeout_ms": 1000,
        "reconnect_attempts": 2,
        "reconnect_delay_ms": 50,
        "decoder_threads": 1,
        "maximum_frame_pixels": 16000000,
        "maximum_frame_bytes": 48000000,
        "color_format": "bgr",
        "pixel_depth": "uint8"
      },
      "position": [
        0,
        0
      ],
      "node_size": "large",
      "exposed_inputs": [
        "ticket"
      ],
      "exposed_outputs": [
        "image",
        "info",
        "ticket",
        "stream_start"
      ],
      "thumbnail": true,
      "preview_output": ""
    },
    {
      "id": "gray",
      "type": "cv.gray",
      "name": "Grayscale",
      "parameters": {
        "algorithm_hint": "default"
      },
      "position": [
        380,
        200
      ],
      "exposed_inputs": [
        "image"
      ],
      "exposed_outputs": [
        "image"
      ],
      "thumbnail": true,
      "preview_output": ""
    },
    {
      "id": "threshold",
      "type": "cv.threshold",
      "name": "Threshold",
      "parameters": {
        "value": 127.0,
        "invert": false,
        "max_value": 255.0,
        "mode": "binary"
      },
      "position": [
        760,
        200
      ],
      "exposed_inputs": [
        "image",
        "mask",
        "region"
      ],
      "exposed_outputs": [
        "image",
        "threshold"
      ],
      "thumbnail": true,
      "preview_output": ""
    },
    {
      "id": "blobs",
      "type": "inspect.blobs",
      "name": "Find blobs",
      "parameters": {
        "connectivity": 8,
        "min_area": 40,
        "max_area": 0,
        "expected_count": 2,
        "algorithm": "default",
        "region_mode": "center",
        "check_count": false
      },
      "position": [
        1140,
        200
      ],
      "exposed_inputs": [
        "image",
        "mask",
        "region"
      ],
      "exposed_outputs": [
        "overlay",
        "mask",
        "count",
        "centroids",
        "data",
        "collection"
      ],
      "thumbnail": true,
      "preview_output": ""
    },
    {
      "id": "track",
      "type": "sequence.track_image",
      "name": "Track image detections",
      "description": "Associate image detections and predict centers, size and angle through bounded gaps.",
      "documentation": "<p>OpenCV Kalman prediction with elapsed acquisition time and gated global assignment. Connect current detections, including an explicit empty list for a missed frame. Observed, predicted, tentative and ambiguous states remain explicit. Confidence is a heuristic, not a probability or a safety judgment.</p><p>Use 180 degree angles for undirected shape axes, 360 for directed pattern poses. Clock, size, uncertainty and expiry controls have parameter tooltips. See docs/image-tracking.md for measurement, coordinate and lifecycle contracts.</p>",
      "parameters": {
        "warmup": 1,
        "max_streams": 4,
        "max_bytes_mb": 128.0,
        "overflow": "error",
        "context_change": "reset",
        "max_gap_ms": 0.0,
        "clock": "auto",
        "nominal_interval_ms": 100.0,
        "minimum_interval_ms": 0.001,
        "maximum_interval_ms": 1000.0,
        "angle_period": "360",
        "maximum_tracks": 64,
        "minimum_observations": 2,
        "emit_tentative": false,
        "emit_predictions": true,
        "maximum_missed_frames": 10,
        "maximum_unobserved_ms": 1000.0,
        "offscreen_margin": 100.0,
        "minimum_detection_score": 0.0,
        "minimum_confidence": 0.05,
        "confidence_decay_ms": 1000.0,
        "label_policy": "if_both",
        "association_distance": 50.0,
        "innovation_gate": 18.5,
        "maximum_scale_ratio": 2.0,
        "maximum_angle_difference": 60.0,
        "ambiguity_margin": 0.05,
        "position_noise": 1.0,
        "scale_noise": 0.05,
        "angle_noise": 5.0,
        "position_acceleration": 10.0,
        "scale_acceleration": 0.1,
        "angular_acceleration": 30.0,
        "initial_position_sigma": 2.0,
        "initial_velocity_sigma": 100.0,
        "initial_scale_sigma": 0.2,
        "initial_scale_velocity_sigma": 0.5,
        "initial_angle_sigma": 20.0,
        "initial_angular_velocity_sigma": 90.0,
        "initial_width": 20.0,
        "initial_height": 20.0,
        "maximum_position_sigma": 100.0,
        "maximum_scale_sigma": 1.0,
        "maximum_angle_sigma": 90.0
      },
      "position": [
        1520,
        0
      ],
      "node_size": "large",
      "exposed_inputs": [
        "image",
        "mask",
        "region",
        "reset",
        "stream",
        "detections",
        "timestamp_ms"
      ],
      "exposed_outputs": [
        "tracks",
        "poses",
        "count",
        "report",
        "ready",
        "activations",
        "status",
        "result_graphics"
      ],
      "thumbnail": true,
      "preview_output": ""
    },
    {
      "id": "overlay",
      "type": "cv.overlay_result_graphics",
      "name": "Overlay result graphics",
      "parameters": {
        "excluded_graphics": {}
      },
      "position": [
        1900,
        0
      ],
      "exposed_inputs": [
        "image",
        "graphics_1",
        "graphics_2"
      ],
      "exposed_outputs": [
        "image"
      ],
      "thumbnail": true,
      "preview_output": ""
    },
    {
      "id": "filmstrip",
      "type": "output.filmstrip_image",
      "name": "Set filmstrip image",
      "parameters": {
        "priority": 0
      },
      "position": [
        2280,
        0
      ],
      "exposed_inputs": [
        "image"
      ],
      "exposed_outputs": [
        "image"
      ],
      "thumbnail": true,
      "preview_output": ""
    },
    {
      "id": "attribution",
      "type": "layout.comment",
      "name": "Original loopback stream - MIT",
      "description": "Original MIT synthetic images, server and projects by OpenCVDataflowGUI contributors. No customer/third-party images. Run starts the program-owned loopback-only MJPEG server; close/new program stops it. Continuous receives frames; Stop ends the decoder and Resume opens a new stream segment. The reconnect example closes each HTTP response after four frames. Stream start resets tracking and a new coordinate identity avoids silently crossing reconnects. Native timestamps are presentation metadata, not exposure time. JPEG is lossy; truth.json gives intended part centers and pinned JPEG hashes. Port 18764 must be free.",
      "parameters": {},
      "position": [
        0,
        -500
      ],
      "node_size": "large",
      "exposed_inputs": [],
      "exposed_outputs": [],
      "thumbnail": true,
      "preview_output": ""
    }
  ],
  "connections": [
    {
      "source": "video",
      "output": "image",
      "target": "gray",
      "input": "image"
    },
    {
      "source": "gray",
      "output": "image",
      "target": "threshold",
      "input": "image"
    },
    {
      "source": "threshold",
      "output": "image",
      "target": "blobs",
      "input": "image"
    },
    {
      "source": "blobs",
      "output": "collection",
      "target": "track",
      "input": "detections"
    },
    {
      "source": "video",
      "output": "image",
      "target": "track",
      "input": "image"
    },
    {
      "source": "video",
      "output": "stream_start",
      "target": "track",
      "input": "reset"
    },
    {
      "source": "video",
      "output": "image",
      "target": "overlay",
      "input": "image"
    },
    {
      "source": "track",
      "output": "result_graphics",
      "target": "overlay",
      "input": "graphics_1"
    },
    {
      "source": "overlay",
      "output": "image",
      "target": "filmstrip",
      "input": "image"
    }
  ]
}
