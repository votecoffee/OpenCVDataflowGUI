{
  "schema_version": 1,
  "blocks": [
    {
      "id": "source",
      "type": "input.file",
      "name": "Image file",
      "parameters": {
        "path": "",
        "source_mode": "files",
        "paths": [
          "assets/train-vertical-0.png",
          "assets/train-vertical-1.png",
          "assets/train-vertical-2.png",
          "assets/train-horizontal-0.png",
          "assets/train-horizontal-1.png",
          "assets/train-horizontal-2.png"
        ],
        "directory": "",
        "recursive": false,
        "repeat": "stop",
        "filename_ticket": true,
        "metadata_mode": "off",
        "color_format": "gray",
        "pixel_depth": "uint8",
        "path_base": "project"
      },
      "position": [
        0,
        0
      ],
      "exposed_inputs": [
        "ticket"
      ],
      "exposed_outputs": [
        "image",
        "info",
        "ticket"
      ],
      "thumbnail": true,
      "preview_output": ""
    },
    {
      "id": "descriptor",
      "type": "inspect.hog",
      "name": "Histogram of oriented gradients",
      "parameters": {
        "cell_size": [
          8,
          8
        ],
        "block_size": [
          16,
          16
        ],
        "block_stride": [
          8,
          8
        ],
        "bins": 9,
        "win_sigma": -1.0,
        "l2_hys_threshold": 0.2,
        "gamma_correction": true,
        "signed_gradient": false
      },
      "position": [
        360,
        0
      ],
      "exposed_inputs": [
        "image"
      ],
      "exposed_outputs": [
        "descriptor",
        "info"
      ],
      "thumbnail": true,
      "preview_output": ""
    },
    {
      "id": "batch",
      "type": "flow.batch",
      "name": "Batch serial entries",
      "parameters": {
        "size": 6,
        "distinct_sources": false,
        "max_pending": 64,
        "max_bytes_mb": 128.0
      },
      "position": [
        720,
        0
      ],
      "exposed_inputs": [
        "item_1",
        "item_2",
        "item_3",
        "item_4"
      ],
      "exposed_outputs": [
        "group",
        "queued"
      ],
      "thumbnail": true,
      "preview_output": ""
    },
    {
      "id": "index",
      "type": "ml.native_ann_build",
      "name": "Build native image embedding index",
      "parameters": {
        "metric": "euclidean",
        "normalization": "none",
        "trees": 3,
        "seed": 7,
        "build_mode": "disk",
        "item_ids": [
          "train-vertical-0.png",
          "train-vertical-1.png",
          "train-vertical-2.png",
          "train-horizontal-0.png",
          "train-horizontal-1.png",
          "train-horizontal-2.png"
        ],
        "labels": [
          "vertical",
          "vertical",
          "vertical",
          "horizontal",
          "horizontal",
          "horizontal"
        ],
        "maximum_index_bytes": 16777216
      },
      "position": [
        1080,
        0
      ],
      "exposed_inputs": [
        "samples",
        "item_ids",
        "labels"
      ],
      "exposed_outputs": [
        "model",
        "count",
        "report"
      ],
      "thumbnail": true,
      "preview_output": ""
    },
    {
      "id": "attribution",
      "type": "layout.comment",
      "name": "Original native image retrieval controls - MIT",
      "description": "Original synthetic stripe images copied unchanged from OpenCVDataflowGUI's K-nearest examples, MIT. Six gallery images and disjoint held-out queries feed HOG or binary block-mean image hashes. Five metrics use native ANN candidates with exact metric reranking; Hamming uses native Euclidean on unpacked bits. Stable IDs are filenames, labels are orientation classes. This controlled fixture does not demonstrate general similarity or inspection accuracy. See README.md/SOURCES.md.",
      "parameters": {},
      "position": [
        0,
        -450
      ],
      "node_size": "large",
      "exposed_inputs": [],
      "exposed_outputs": [],
      "thumbnail": true,
      "preview_output": ""
    }
  ],
  "connections": [
    {
      "source": "source",
      "output": "image",
      "target": "descriptor",
      "input": "image"
    },
    {
      "source": "descriptor",
      "output": "descriptor",
      "target": "batch",
      "input": "item_1"
    },
    {
      "source": "batch",
      "output": "group",
      "target": "index",
      "input": "samples"
    }
  ]
}
