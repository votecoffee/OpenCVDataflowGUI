      "description": "Reproject registered depth and color into a new optical frame.",
      "parameters": {
        "color_alignment": "assume_registered",
        "input_units": "m",
        "units_per_sample": 0.001,
        "minimum_coverage": 0.25,
        "display_max_m": 5.0
      },
      "position": [
        400,
        170
      ],
      "exposed_inputs": [
        "depth",
        "camera",
        "transform",
        "color",
        "mask",
