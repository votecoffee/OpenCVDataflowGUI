      "parameters": {
        "output_name": "scores",
        "labels": [
          "red",
          "green",
          "blue"
        ],
        "softmax": true,
        "top_k": 5,
        "minimum_confidence": 0.0,
        "accepted_labels": [
          "green"
        ]
      },
      "position": [
        1840,
        0
      ],
      "exposed_inputs": [
        "tensors"
      ],
      "exposed_outputs": [
        "predictions",
        "label",
        "confidence"
      ],
      "thumbnail": true,
      "preview_output": ""
    },
    {
      "id": "attribution",
      "type": "layout.comment",
      "name": "Original batch controls - MIT",
      "description": "Original MIT images, ONNX arithmetic models, graphs and independent references by OpenCVDataflowGUI contributors. No customer/third-party assets or learned weights. Three captures have distinct tickets and grids. Results retain stored order, source images and per-image preprocessing. Default Select shows green row 1; Grayscale uses one channel and Serial emits all three rows. Variable tail submits 2+1 rows; fixed padding submits 2+2 but returns only 3. Reject-tail, wrong-signature, mixed-source-size and collapsed-output projects intentionally emit no predictions. See README and truth.json.",
      "parameters": {},
      "position": [
        0,
        -500
      ],
      "node_size": "large",
      "exposed_inputs": [],
      "exposed_outputs": [],
      "thumbnail": true,
      "preview_output": ""
    }
