    {
      "id": "infer",
      "type": "ml.dnn_batch",
      "name": "Batched ONNX image inference",
      "parameters": {
        "model_path": "assets/dynamic.onnx",
        "width": 8,
        "height": 8,
        "color_format": "rgb",
        "resize_mode": "stretch",
        "padding_value": 0.0,
        "scale": 0.00392156862745098,
        "mean": [
          0.0,
          0.0,
          0.0
        ],
        "std": [
          1.0,
          1.0,
          1.0
        ],
        "input_name": "image",
        "output_names": [
          "scores"
        ],
        "engine": "classic",
        "backend": "opencv",
        "target": "cpu",
        "fusion": true,
        "max_output_elements": 1000000,
        "input_shape": [
          -1,
          3,
          -1,
          -1
        ],
        "batch_size": 2,
        "tail_policy": "reject",
        "spatial_mode": "configured",
        "maximum_images": 64,
        "maximum_image_pixels": 16777216,
        "maximum_source_pixels": 32000000,
        "maximum_tensor_elements": 4000000
      },
      "position": [
        760,
        0
      ],
      "exposed_inputs": [
        "images",
        "masks",
        "regions"
      ],
      "exposed_outputs": [
        "results",
        "info"
