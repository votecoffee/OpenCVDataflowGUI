      "exposed_inputs": [
        "image"
      ],
      "exposed_outputs": [
        "image"
      ],
      "thumbnail": true,
      "preview_output": ""
    },
    {
      "id": "attribution",
      "type": "layout.comment",
      "name": "Annotated original part motion - MIT",
      "description": "Original MIT fixtures and projects by OpenCVDataflowGUI contributors. No customer or external images. Run All consumes twenty frames. Actual OpenCV blob measurements drive the image tracker; independent truth.json records intended motion, scale, angle and hidden frames. Green is observed and amber predicted. First detection is tentative; predictions are estimates, not fresh observations. The four-frame gap retains identity in oriented_gaps and expires it in expire_reacquire. Reappearance gets a fresh ID after expiry. Reset to replay. These are controlled synthetic tracker tests, not production accuracy evidence.",
      "parameters": {},
      "position": [
        0,
        -400
      ],
      "node_size": "large",
      "exposed_inputs": [],
      "exposed_outputs": [],
      "thumbnail": true,
      "preview_output": ""
    }
  ],
  "connections": [
