{
  "schema_version": 1,
  "blocks": [
    {
      "id": "source",
      "type": "input.file",
      "name": "Image file",
      "parameters": {
        "path": "",
        "source_mode": "files",
        "paths": [
          "assets/train-0.png",
          "assets/train-1.png",
          "assets/train-2.png",
          "assets/train-3.png",
          "assets/train-4.png",
          "assets/train-5.png",
          "assets/train-6.png",
          "assets/train-7.png",
          "assets/train-8.png"
        ],
        "directory": "",
        "recursive": false,
        "repeat": "stop",
        "filename_ticket": true,
        "metadata_mode": "off",
        "color_format": "gray",
        "pixel_depth": "uint8",
        "path_base": "project"
      },
      "position": [
        0,
        0
      ],
      "exposed_inputs": [
        "ticket"
      ],
      "exposed_outputs": [
        "image",
        "info",
        "ticket"
      ],
      "thumbnail": true,
      "preview_output": ""
    },
    {
      "id": "hog",
      "type": "inspect.hog",
      "name": "Histogram of oriented gradients",
      "parameters": {
        "cell_size": [
          8,
          8
        ],
        "block_size": [
          16,
          16
        ],
        "block_stride": [
          8,
          8
        ],
        "bins": 4,
        "win_sigma": -1.0,
        "l2_hys_threshold": 0.2,
        "gamma_correction": true,
        "signed_gradient": false
      },
      "position": [
        360,
        0
      ],
      "exposed_inputs": [
        "image"
      ],
      "exposed_outputs": [
        "descriptor",
        "info"
      ],
      "thumbnail": true,
      "preview_output": ""
    },
    {
      "id": "batch",
      "type": "flow.batch",
      "name": "Batch serial entries",
      "parameters": {
        "size": 9,
        "distinct_sources": false,
        "max_pending": 64,
        "max_bytes_mb": 128.0
      },
      "position": [
        720,
        0
      ],
      "exposed_inputs": [
        "item_1",
        "item_2",
        "item_3",
        "item_4"
      ],
      "exposed_outputs": [
        "group",
        "queued"
      ],
      "thumbnail": true,
      "preview_output": ""
    },
    {
      "id": "fit",
      "type": "cv.feature_covariance",
      "name": "Fit feature covariance",
      "parameters": {
        "samples": [],
        "normalization": "sample",
        "feature_normalization": "l2",
        "mean": [],
        "max_work": 64000000,
        "max_bytes_mb": 128.0
      },
      "position": [
        1080,
        0
      ],
      "exposed_inputs": [
        "samples"
      ],
      "exposed_outputs": [
        "model",
        "mean",
        "covariance",
        "sample_count"
      ],
      "thumbnail": true,
      "preview_output": ""
    },
    {
      "id": "save",
      "type": "cv.save_feature_covariance",
      "name": "Save feature covariance",
      "parameters": {
        "path": "trained-covariance-l2.json"
      },
      "position": [
        1440,
        0
      ],
      "exposed_inputs": [
        "model"
      ],
      "exposed_outputs": [
        "path"
      ],
      "thumbnail": true,
      "preview_output": ""
    },
    {
      "id": "attribution",
      "type": "layout.comment",
      "name": "Original known-good feature inspection controls",
      "description": "Original MIT synthetic part images, edit masks, models and graphs by OpenCVDataflowGUI contributors. Nine training views have +/-1 pixel shifts and separate noise. Held-out noise, gain changes and edits are excluded from fitting. Four-bin HOG has 144 values; sample covariance plus explicit Ridge measures whole-window deviation. A crack, removed arc and empty view fail; a subtle one-pixel intensity edit passes and remains a documented miss. Whole-window graphics do not localize defects. Distance is not a probability or physical measurement. See README.md, SOURCES.md and benchmark.json.",
      "parameters": {},
      "position": [
        0,
        -480
      ],
      "node_size": "large",
      "exposed_inputs": [],
      "exposed_outputs": [],
      "thumbnail": true,
      "preview_output": ""
    }
  ],
  "connections": [
    {
      "source": "source",
      "output": "image",
      "target": "hog",
      "input": "image"
    },
    {
      "source": "hog",
      "output": "descriptor",
      "target": "batch",
      "input": "item_1"
    },
    {
      "source": "batch",
      "output": "group",
      "target": "fit",
      "input": "samples"
    },
    {
      "source": "fit",
      "output": "model",
      "target": "save",
      "input": "model"
    }
  ]
