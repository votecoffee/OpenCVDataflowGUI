      "parameters": {
        "path": "assets/covariance-none.json"
      },
      "position": [
        360,
        440
      ],
      "exposed_inputs": [],
      "exposed_outputs": [
        "model"
      ],
      "thumbnail": true,
      "preview_output": ""
    },
    {
      "id": "inspect",
