      ],
      "thumbnail": true,
      "preview_output": ""
    },
    {
      "id": "attribution",
      "type": "layout.comment",
      "name": "Original known-good feature inspection controls",
      "description": "Original MIT synthetic part images, edit masks, models and graphs by OpenCVDataflowGUI contributors. Nine training views have +/-1 pixel shifts and separate noise. Held-out noise, gain changes and edits are excluded from fitting. Four-bin HOG has 144 values; sample covariance plus explicit Ridge measures whole-window deviation. A crack, removed arc and empty view fail; a subtle one-pixel intensity edit passes and remains a documented miss. Whole-window graphics do not localize defects. Distance is not a probability or physical measurement. See README.md, SOURCES.md and benchmark.json.",
      "parameters": {},
      "position": [
        0,
        -480
      ],
      "node_size": "large",
      "exposed_inputs": [],
      "exposed_outputs": [],
      "thumbnail": true,
      "preview_output": ""
    }
