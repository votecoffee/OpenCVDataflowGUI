      "name": "Mahalanobis distance",
      "parameters": {
        "samples": [],
        "ridge": 0.001,
        "check_distance": false,
        "distance_limit": 4,
        "contract_policy": "require_match",
        "max_work": 64000000,
        "max_bytes_mb": 128.0
