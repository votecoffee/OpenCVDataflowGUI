        "local_fb_tolerance": 1.0,
        "local_min_points": 4,
        "local_min_inliers": 0.6,
        "local_min_span": 3.0,
        "local_max_shift": 30.0,
        "local_max_scale": 1.2,
        "local_max_angle": 20.0,
        "local_work_limit": 32000000,
        "fit_threshold": 2.0,
        "fit_iterations": 200,
        "fit_confidence": 0.99,
        "fit_refine_iterations": 10
      },
