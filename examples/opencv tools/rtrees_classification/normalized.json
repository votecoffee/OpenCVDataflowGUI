{
  "schema_version": 1,
  "blocks": [
    {
      "id": "source",
      "type": "input.file",
      "name": "Image file",
      "parameters": {
        "path": "",
        "source_mode": "files",
        "paths": [
          "assets/heldout-vertical.png",
          "assets/heldout-horizontal.png"
        ],
        "directory": "",
        "recursive": false,
        "repeat": "stop",
        "filename_ticket": true,
        "metadata_mode": "off",
        "color_format": "gray",
        "pixel_depth": "uint8",
        "path_base": "project"
      },
      "position": [
        0,
        0
      ],
      "exposed_inputs": [
        "ticket"
      ],
      "exposed_outputs": [
        "image",
        "info",
        "ticket"
      ],
      "thumbnail": true,
      "preview_output": ""
    },
    {
      "id": "hog",
      "type": "inspect.hog",
      "name": "Histogram of oriented gradients",
      "parameters": {
        "cell_size": [
          8,
          8
        ],
        "block_size": [
          16,
          16
        ],
        "block_stride": [
          8,
          8
        ],
        "bins": 9,
        "win_sigma": -1.0,
        "l2_hys_threshold": 0.2,
        "gamma_correction": true,
        "signed_gradient": false
      },
      "position": [
        360,
        0
      ],
      "exposed_inputs": [
        "image"
      ],
      "exposed_outputs": [
        "descriptor",
        "info"
      ],
      "thumbnail": true,
      "preview_output": ""
    },
    {
      "id": "model",
      "type": "ml.rtrees_load",
      "name": "Load random forest classifier",
      "parameters": {
        "path": "assets/forest-l2.json"
      },
      "position": [
        360,
        420
      ],
      "exposed_inputs": [],
      "exposed_outputs": [
        "model"
      ],
      "thumbnail": true,
      "preview_output": ""
    },
    {
      "id": "predict",
      "type": "ml.rtrees_predict",
      "name": "Predict OpenCV random forest classes",
      "parameters": {
        "contract_policy": "require_match",
        "min_vote_fraction": 0.0,
        "min_vote_margin": 0.0,
        "reject_vote_ties": true,
        "accepted_labels": []
      },
      "position": [
        720,
        0
      ],
      "exposed_inputs": [
        "model",
        "samples",
        "image"
      ],
      "exposed_outputs": [
        "labels",
        "label",
        "candidate_labels",
        "votes",
        "vote_fractions",
        "accepted",
        "image",
        "report",
        "result_graphics"
      ],
      "thumbnail": true,
      "preview_output": ""
    },
    {
      "id": "overlay",
      "type": "cv.overlay_result_graphics",
      "name": "Overlay result graphics",
      "parameters": {
        "excluded_graphics": {}
      },
      "position": [
        1080,
        0
      ],
      "exposed_inputs": [
        "image",
        "graphics_1",
        "graphics_2"
      ],
      "exposed_outputs": [
        "image"
      ],
      "thumbnail": true,
      "preview_output": ""
    },
    {
      "id": "filmstrip",
      "type": "output.filmstrip_image",
      "name": "Set filmstrip image",
      "parameters": {
        "priority": 0
      },
      "position": [
        1440,
        0
      ],
      "exposed_inputs": [
        "image"
      ],
      "exposed_outputs": [
        "image"
      ],
      "thumbnail": true,
      "preview_output": ""
    },
    {
      "id": "attribution",
      "type": "layout.comment",
      "name": "Original synthetic forest classification controls",
      "description": "Original stripe images/code by OpenCVDataflowGUI contributors, MIT. Images copied unchanged from knn_classification. No external media, tutorial code or pretrained model. Frozen forests are generated by actual native training in a separate preparation process with recorded seeds; runtime training never changes the host RNG seed. Known/diagonal vote behavior is a bounded CPU fixture, not general novelty detection or production accuracy. Wrong preprocessing intentionally errors without prediction events. See README.md and SOURCES.md.",
      "parameters": {},
      "position": [
        0,
        -480
      ],
      "node_size": "large",
      "exposed_inputs": [],
      "exposed_outputs": [],
      "thumbnail": true,
      "preview_output": ""
    }
  ],
  "connections": [
    {
      "source": "source",
      "output": "image",
      "target": "hog",
      "input": "image"
    },
    {
      "source": "source",
      "output": "image",
      "target": "predict",
      "input": "image"
    },
    {
      "source": "hog",
      "output": "descriptor",
      "target": "predict",
      "input": "samples"
    },
    {
      "source": "model",
      "output": "model",
      "target": "predict",
      "input": "model"
    },
    {
      "source": "predict",
      "output": "image",
      "target": "overlay",
      "input": "image"
    },
    {
      "source": "predict",
      "output": "result_graphics",
      "target": "overlay",
      "input": "graphics_1"
    },
    {
      "source": "overlay",
      "output": "image",
      "target": "filmstrip",
      "input": "image"
    }
  ]
}
