{
  "schema_version": 1,
  "blocks": [
    {
      "id": "source",
      "type": "input.file",
      "name": "Image file",
      "parameters": {
        "path": "",
        "source_mode": "files",
        "paths": [
          "assets/train-vertical-0.png",
          "assets/train-vertical-1.png",
          "assets/train-vertical-2.png",
          "assets/train-horizontal-0.png",
          "assets/train-horizontal-1.png",
          "assets/train-horizontal-2.png"
        ],
        "directory": "",
        "recursive": false,
        "repeat": "stop",
        "filename_ticket": true,
        "metadata_mode": "off",
        "color_format": "gray",
        "pixel_depth": "uint8",
        "path_base": "project"
      },
      "position": [
        0,
        0
      ],
      "exposed_inputs": [
        "ticket"
      ],
      "exposed_outputs": [
        "image",
        "info",
        "ticket"
      ],
      "thumbnail": true,
      "preview_output": ""
    },
    {
      "id": "hog",
      "type": "inspect.hog",
      "name": "Histogram of oriented gradients",
      "parameters": {
        "cell_size": [
          8,
          8
        ],
        "block_size": [
          16,
          16
        ],
        "block_stride": [
          8,
          8
        ],
        "bins": 9,
        "win_sigma": -1.0,
        "l2_hys_threshold": 0.2,
        "gamma_correction": true,
        "signed_gradient": false
      },
      "position": [
        360,
        0
      ],
      "exposed_inputs": [
        "image"
      ],
      "exposed_outputs": [
        "descriptor",
        "info"
      ],
      "thumbnail": true,
      "preview_output": ""
    },
    {
      "id": "batch",
      "type": "flow.batch",
      "name": "Batch serial entries",
      "parameters": {
        "size": 6,
        "distinct_sources": false,
        "max_pending": 64,
        "max_bytes_mb": 128.0
      },
      "position": [
        720,
        0
      ],
      "exposed_inputs": [
        "item_1",
        "item_2",
        "item_3",
        "item_4"
      ],
      "exposed_outputs": [
        "group",
        "queued"
      ],
      "thumbnail": true,
      "preview_output": ""
    },
    {
      "id": "train",
      "type": "ml.rtrees_train",
      "name": "Train OpenCV random forest classifier",
      "parameters": {
        "max_depth": 10,
        "min_sample_count": 2,
        "active_variables": 0,
        "max_trees": 64,
        "termination": "tree_limit",
        "oob_error": 0.01,
        "calculate_importance": false,
        "class_priors": [],
        "normalization": "l2",
        "labels": [
          "vertical",
          "vertical",
          "vertical",
          "horizontal",
          "horizontal",
          "horizontal"
        ],
        "sample_weights": []
      },
      "position": [
        1080,
        0
      ],
      "exposed_inputs": [
        "samples",
        "labels",
        "sample_weights"
      ],
      "exposed_outputs": [
        "model",
        "importance",
        "report"
      ],
      "thumbnail": true,
      "preview_output": ""
    },
    {
      "id": "save",
      "type": "ml.rtrees_save",
      "name": "Save random forest classifier",
      "parameters": {
        "path": "trained-train_normalized.json"
      },
      "position": [
        1440,
        0
      ],
      "exposed_inputs": [
        "model"
      ],
      "exposed_outputs": [
        "path"
      ],
      "thumbnail": true,
      "preview_output": ""
    },
    {
      "id": "attribution",
      "type": "layout.comment",
      "name": "Original synthetic forest classification controls",
      "description": "Original stripe images/code by OpenCVDataflowGUI contributors, MIT. Images copied unchanged from knn_classification. No external media, tutorial code or pretrained model. Frozen forests are generated by actual native training in a separate preparation process with recorded seeds; runtime training never changes the host RNG seed. Known/diagonal vote behavior is a bounded CPU fixture, not general novelty detection or production accuracy. Wrong preprocessing intentionally errors without prediction events. See README.md and SOURCES.md.",
      "parameters": {},
      "position": [
        0,
        -480
      ],
      "node_size": "large",
      "exposed_inputs": [],
      "exposed_outputs": [],
      "thumbnail": true,
      "preview_output": ""
    }
  ],
  "connections": [
    {
      "source": "source",
      "output": "image",
      "target": "hog",
      "input": "image"
    },
    {
      "source": "hog",
      "output": "descriptor",
      "target": "batch",
      "input": "item_1"
    },
    {
      "source": "batch",
      "output": "group",
      "target": "train",
      "input": "samples"
    },
    {
      "source": "train",
      "output": "model",
      "target": "save",
      "input": "model"
    }
  ]
}
