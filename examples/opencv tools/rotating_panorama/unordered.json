    {
      "id": "panorama",
      "type": "cv.stitch_rotating_panorama",
      "name": "Stitch rotating-camera views",
      "description": "Register unordered views from a rotating camera.",
      "documentation": "<p>Native panorama camera estimation plus independent overlap/rotation-model checks. Masks restrict registration and supported rendering. Source depth is retained; panorama coordinates are a new nonlinear grid. See docs/rotating-panorama.md. Rotation/static-scene assumptions require camera qualification.</p>",
      "parameters": {
        "camera_solver": "automatic",
        "bundle_adjustment": "reprojection",
        "initial_intrinsics": [],
        "refine_focal": true,
        "refine_aspect": false,
        "refine_principal_point": false,
        "camera_features": 1500,
        "native_match_confidence": 0.65,
        "adjustment_iterations": 100,
        "adjustment_epsilon": 1e-06,
        "holdout_fraction": 0.35,
        "holdout_seed": 104,
        "reference_index": 0,
        "anchor_label": "center",
        "source_labels": [],
        "component_policy": "reject",
        "projection": "spherical",
        "projection_scale": 280.0,
        "wave_correction": "none",
        "registration_megapixels": 0.2,
        "native_confidence": 0.5,
        "verification_features": 1000,
        "maximum_verification_pairs": 32000000,
        "match_ratio": 0.75,
        "maximum_descriptor_distance": 400.0,
        "minimum_inliers": 12,
        "minimum_inlier_ratio": 0.3,
        "inlier_pixels": 3.0,
        "maximum_camera_error": 3.0,
        "ransac_iterations": 2000,
        "ransac_confidence": 0.995,
        "minimum_focal_ratio": 0.2,
        "maximum_focal_ratio": 5.0,
        "interpolation": "linear",
        "blend": "average",
        "minimum_covered_fraction": 0.0,
        "maximum_input_pixels": 16777216,
        "maximum_output_pixels": 8388608,
        "maximum_working_bytes": 536870912
      },
      "position": [
        1140,
        0
      ],
      "node_size": "large",
      "exposed_inputs": [
        "views",
        "masks",
        "regions"
      ],
      "exposed_outputs": [
