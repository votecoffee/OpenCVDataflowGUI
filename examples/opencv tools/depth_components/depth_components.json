      "type": "3d.depth_components",
      "name": "Measure depth components",
      "parameters": {
        "minimum_depth_m": 0.001,
        "maximum_depth_m": 1.4,
        "maximum_depth_step_m": 0.035,
        "connectivity": "8",
        "minimum_pixels": 12,
        "maximum_pixels": 0,
        "maximum_components": 256,
        "preview_count": 25,
        "input_units": "m",
        "units_per_sample": 0.001
      },
      "position": [
        350,
        50
      ],
