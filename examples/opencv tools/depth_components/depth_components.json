        "labels",
        "mask",
        "candidate_mask",
        "report"
      ],
      "thumbnail": true,
      "preview_output": "Depth components"
    },
    {
      "id": "wide",
      "type": "collection.filter",
      "name": "Retain width of at least 190 mm",
      "parameters": {
        "metric": "custom",
        "custom_metric": "width_m",
        "use_minimum": true,
        "minimum": 0.19,
        "include_minimum": true,
        "use_maximum": false,
        "maximum": 0.0,
        "include_maximum": true,
        "invert_range": false,
        "missing": "reject",
        "reference_point": [
          0.0,
          0.0
        ]
      },
      "position": [
        710,
        55
      ],
      "exposed_inputs": [
        "collection",
        "mask",
        "region"
      ],
      "exposed_outputs": [
        "collection",
        "count",
        "points",
        "rejected",
        "rejected_count"
