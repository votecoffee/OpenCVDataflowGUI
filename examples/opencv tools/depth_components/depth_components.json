      "parameters": {
        "path": "assets/depth_mm.png",
        "path_base": "project",
        "units_per_sample": 1,
        "units": "mm",
        "display_min": 750,
        "display_max": 1800
      },
      "position": [
        0,
        30
      ],
      "exposed_inputs": [
        "ticket"
      ],
      "exposed_outputs": [
        "depth",
        "preview",
        "info",
        "ticket"
      ],
      "thumbnail": true,
      "preview_output": ""
    },
    {
