{
  "schema_version": 1,
  "blocks": [
    {
      "id": "video",
      "type": "input.video_at_time",
      "name": "Video frame at time",
      "description": "Sample a video at a requested presentation time.",
      "documentation": "<p>Nearest/earlier/later selection reports actual position and time error. Each request is independent and receives a fresh ticket/pixel frame. See docs/video-time-seeking.md for native bracketing, fallback and limits.</p>",
      "parameters": {
        "path": "assets/time_samples.avi",
        "path_base": "project",
        "backend": "ffmpeg",
        "time_ms": 175,
        "selection": "at_or_after",
        "seek_method": "native_then_scan",
        "preroll_ms": 0.0,
        "maximum_error_ms": 1000.0,
        "timestamp_policy": "decoder_only",
        "frame_ticket": true,
        "open_timeout_ms": 5000,
        "read_timeout_ms": 5000,
        "decoder_threads": 1,
        "maximum_read_frames": 10000,
        "maximum_frame_pixels": 16000000,
        "maximum_working_bytes": 268435456,
        "color_format": "bgr",
        "pixel_depth": "uint8"
      },
      "position": [
        0,
        0
      ],
      "node_size": "large",
      "exposed_inputs": [
        "time_ms",
        "ticket"
      ],
      "exposed_outputs": [
        "image",
        "info",
        "ticket"
      ],
      "thumbnail": true,
      "preview_output": ""
    },
    {
      "id": "gray",
      "type": "cv.gray",
      "name": "Grayscale",
      "parameters": {
        "algorithm_hint": "default"
      },
      "position": [
        380,
        200
      ],
      "exposed_inputs": [
        "image"
      ],
      "exposed_outputs": [
        "image"
      ],
      "thumbnail": true,
      "preview_output": ""
    },
    {
      "id": "threshold",
      "type": "cv.threshold",
      "name": "Threshold",
      "parameters": {
        "value": 127.0,
        "invert": false,
        "max_value": 255.0,
        "mode": "binary"
      },
      "position": [
        760,
        200
      ],
      "exposed_inputs": [
        "image",
        "mask",
        "region"
      ],
      "exposed_outputs": [
        "image",
        "threshold"
      ],
      "thumbnail": true,
      "preview_output": ""
    },
    {
      "id": "blobs",
      "type": "inspect.blobs",
      "name": "Find blobs",
      "parameters": {
        "connectivity": 8,
        "min_area": 40,
        "max_area": 0,
        "expected_count": 2,
        "algorithm": "default",
        "region_mode": "center",
        "check_count": false
      },
      "position": [
        1140,
        200
      ],
      "exposed_inputs": [
        "image",
        "mask",
        "region"
      ],
      "exposed_outputs": [
        "overlay",
        "mask",
        "count",
        "centroids",
        "data",
        "collection",
        "result_graphics"
      ],
      "thumbnail": true,
      "preview_output": ""
    },
    {
      "id": "overlay",
      "type": "cv.overlay_result_graphics",
      "name": "Overlay result graphics",
      "parameters": {
        "excluded_graphics": {}
      },
      "position": [
        1520,
        0
      ],
      "exposed_inputs": [
        "image",
        "graphics_1",
        "graphics_2"
      ],
      "exposed_outputs": [
        "image"
      ],
      "thumbnail": true,
      "preview_output": ""
    },
    {
      "id": "filmstrip",
      "type": "output.filmstrip_image",
      "name": "Set filmstrip image",
      "parameters": {
        "priority": 0
      },
      "position": [
        1900,
        0
      ],
      "exposed_inputs": [
        "image"
      ],
      "exposed_outputs": [
        "image"
      ],
      "thumbnail": true,
      "preview_output": ""
    },
    {
      "id": "attribution",
      "type": "layout.comment",
      "name": "Original media-time fixture - MIT",
      "description": "Original MIT synthetic clip, generator, annotations and projects by OpenCVDataflowGUI contributors. No customer or third-party images. Eight lossless 20 FPS frames contain a moving 28 by 24 pixel part. Native exact requests 250 ms (frame 5). At 175 ms nearest/earlier selects 150 ms (frame 3); later selects 200 ms (frame 4). Native positioning overshoots to 200 ms on this fixture, so bounded scanning verifies the bracket. The error-guard project deliberately rejects 225 ms because its nearest frame is 25 ms away and only 10 ms error is allowed. Each Run once is an independent sample with a fresh ticket and pixel frame; it does not advance a playback cursor. See truth.json for original frame hashes and geometry.",
      "parameters": {},
      "position": [
        0,
        -500
      ],
      "node_size": "large",
      "exposed_inputs": [],
      "exposed_outputs": [],
      "thumbnail": true,
      "preview_output": ""
    }
  ],
  "connections": [
    {
      "source": "video",
      "output": "image",
      "target": "gray",
      "input": "image"
    },
    {
      "source": "gray",
      "output": "image",
      "target": "threshold",
      "input": "image"
    },
    {
      "source": "threshold",
      "output": "image",
      "target": "blobs",
      "input": "image"
    },
    {
      "source": "video",
      "output": "image",
      "target": "overlay",
      "input": "image"
    },
    {
      "source": "blobs",
      "output": "result_graphics",
      "target": "overlay",
      "input": "graphics_1"
    },
    {
      "source": "overlay",
      "output": "image",
      "target": "filmstrip",
      "input": "image"
    }
  ]
}
