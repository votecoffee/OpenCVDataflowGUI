    {
      "id": "straight",
      "type": "cv.alpha_over",
      "name": "Source over \u2014 straight alpha",
      "documentation": "<p>Source-over composition uses Ao = Af + Ab(1-Af) and associated color Co = Cf Af + Cb Ab(1-Af). Straight output divides Co by Ao where Ao is positive. Fully transparent selected pixels have zero color.</p><p><a href=\"https://www.w3.org/TR/compositing-1/#porterduffcompositingoperators\">W3C source-over reference</a>. This CPU implementation handles alpha association, pixel depths, color order and optional linear sRGB blending explicitly.</p>",
      "parameters": {
        "foreground_representation": "straight",
        "background_representation": "auto",
        "output_representation": "straight",
        "output_format": "background",
        "output_depth": "background",
        "blend_space": "stored",
        "opacity": 1.0,
        "alignment": "pixel_grid",
        "ticket_policy": "background"
      },
      "position": [
        400.0,
        0.0
      ],
      "exposed_inputs": [
        "foreground",
        "background",
        "alpha",
        "mask",
        "region"
      ],
      "exposed_outputs": [
