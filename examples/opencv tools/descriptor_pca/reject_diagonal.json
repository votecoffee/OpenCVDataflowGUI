{
  "schema_version": 1,
  "blocks": [
    {
      "id": "source",
      "type": "input.file",
      "name": "Image file",
      "parameters": {
        "path": "",
        "source_mode": "files",
        "paths": [
          "assets/heldout-diagonal.png"
        ],
        "directory": "",
        "recursive": false,
        "repeat": "stop",
        "filename_ticket": true,
        "metadata_mode": "off",
        "color_format": "gray",
        "pixel_depth": "uint8",
        "path_base": "project"
      },
      "position": [
        0,
        0
      ],
      "exposed_inputs": [
        "ticket"
      ],
      "exposed_outputs": [
        "image",
        "info",
        "ticket"
      ],
      "thumbnail": true,
      "preview_output": ""
    },
    {
      "id": "hog",
      "type": "inspect.hog",
      "name": "Histogram of oriented gradients",
      "parameters": {
        "cell_size": [
          8,
          8
        ],
        "block_size": [
          16,
          16
        ],
        "block_stride": [
          8,
          8
        ],
        "bins": 9,
        "win_sigma": -1.0,
        "l2_hys_threshold": 0.2,
        "gamma_correction": true,
        "signed_gradient": false
      },
      "position": [
        360,
        0
      ],
      "exposed_inputs": [
        "image"
      ],
      "exposed_outputs": [
        "descriptor",
        "info"
      ],
      "thumbnail": true,
      "preview_output": ""
    },
    {
      "id": "pca",
      "type": "cv.load_pca",
      "name": "Load principal component model",
      "parameters": {
        "path": "assets/pca-none.json"
      },
      "position": [
        360,
        380
      ],
      "exposed_inputs": [],
      "exposed_outputs": [
        "model"
      ],
      "thumbnail": true,
      "preview_output": ""
    },
    {
      "id": "project",
      "type": "cv.transform_pca",
      "name": "Transform principal components",
      "parameters": {
        "samples": [],
        "direction": "project",
        "contract_policy": "require_match",
        "check_reconstruction_error": true,
        "error_limit": 0.03,
        "max_work": 64000000,
        "max_bytes_mb": 128.0
      },
      "position": [
        720,
        0
      ],
      "exposed_inputs": [
        "model",
        "samples",
        "image"
      ],
      "exposed_outputs": [
        "samples",
        "feature_count",
        "reconstruction_errors",
        "maximum_error",
        "report",
        "image",
        "result_graphics"
      ],
      "thumbnail": true,
      "preview_output": ""
    },
    {
      "id": "overlay",
      "type": "cv.overlay_result_graphics",
      "name": "Overlay result graphics",
      "parameters": {
        "excluded_graphics": {}
      },
      "position": [
        1440,
        0
      ],
      "exposed_inputs": [
        "image",
        "graphics_1",
        "graphics_2"
      ],
      "exposed_outputs": [
        "image"
      ],
      "thumbnail": true,
      "preview_output": ""
    },
    {
      "id": "filmstrip",
      "type": "output.filmstrip_image",
      "name": "Set filmstrip image",
      "parameters": {
        "priority": 0
      },
      "position": [
        1800,
        0
      ],
      "exposed_inputs": [
        "image"
      ],
      "exposed_outputs": [
        "image"
      ],
      "thumbnail": true,
      "preview_output": ""
    },
    {
      "id": "attribution",
      "type": "layout.comment",
      "name": "Original image-descriptor PCA controls",
      "description": "Original MIT synthetic stripe images and code by OpenCVDataflowGUI contributors. Nine images copied unchanged from knn_classification. Six training images and three held-out image hashes are disjoint. PCA and classifier models are trained only on the six training windows. Training variance is not held-out accuracy; reconstruction error and nearest-neighbor distance are not probabilities. These controlled windows do not establish general defect/classification performance. See README and SOURCES.",
      "parameters": {},
      "position": [
        0,
        -470
      ],
      "node_size": "large",
      "exposed_inputs": [],
      "exposed_outputs": [],
      "thumbnail": true,
      "preview_output": ""
    }
  ],
  "connections": [
    {
      "source": "source",
      "output": "image",
      "target": "hog",
      "input": "image"
    },
    {
      "source": "hog",
      "output": "descriptor",
      "target": "project",
      "input": "samples"
    },
    {
      "source": "pca",
      "output": "model",
      "target": "project",
      "input": "model"
    },
    {
      "source": "source",
      "output": "image",
      "target": "project",
      "input": "image"
    },
    {
      "source": "project",
      "output": "image",
      "target": "overlay",
      "input": "image"
    },
    {
      "source": "project",
      "output": "result_graphics",
      "target": "overlay",
      "input": "graphics_1"
    },
    {
      "source": "overlay",
      "output": "image",
      "target": "filmstrip",
      "input": "image"
    }
  ]
}
