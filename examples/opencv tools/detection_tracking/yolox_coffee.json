    {
      "id": "track",
      "type": "sequence.track_image",
      "name": "Track image detections",
      "description": "Associate image detections and predict centers, size and angle through bounded gaps.",
      "documentation": "<p>OpenCV Kalman prediction with elapsed acquisition time and gated global assignment. Connect current detections, including an explicit empty list for a missed frame. Observed, predicted, tentative and ambiguous states remain explicit. Confidence is a heuristic, not a probability or a safety judgment.</p><p>Use 180 degree angles for undirected shape axes, 360 for directed pattern poses. Clock, size, uncertainty and expiry controls have parameter tooltips. See docs/image-tracking.md for measurement, coordinate and lifecycle contracts.</p>",
      "parameters": {
        "warmup": 1,
        "max_streams": 4,
        "max_bytes_mb": 128.0,
        "overflow": "error",
        "context_change": "reset",
        "max_gap_ms": 0.0,
        "clock": "nominal",
        "nominal_interval_ms": 100.0,
        "minimum_interval_ms": 0.001,
        "maximum_interval_ms": 1000.0,
        "angle_period": "180",
        "maximum_tracks": 64,
        "minimum_observations": 1,
        "emit_tentative": false,
        "emit_predictions": true,
        "maximum_missed_frames": 4,
        "maximum_unobserved_ms": 2000,
        "offscreen_margin": 100.0,
        "minimum_detection_score": 0.0,
        "minimum_confidence": 0,
        "confidence_decay_ms": 1000.0,
        "label_policy": "if_both",
        "appearance_policy": "required",
        "appearance_weight": 0.9,
        "maximum_appearance_distance": 0.5,
        "appearance_update_rate": 0.2,
        "maximum_appearance_dimensions": 512,
        "association_distance": 200,
        "innovation_gate": 1000000.0,
        "maximum_scale_ratio": 2.0,
        "maximum_angle_difference": 180,
        "ambiguity_margin": 0.05,
        "position_noise": 0.05,
        "scale_noise": 0.05,
        "angle_noise": 5.0,
        "position_acceleration": 500,
        "scale_acceleration": 0.1,
        "angular_acceleration": 30.0,
        "initial_position_sigma": 2.0,
        "initial_velocity_sigma": 100.0,
