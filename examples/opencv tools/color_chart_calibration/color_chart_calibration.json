      "exposed_outputs": [
        "model",
        "matrix",
        "statistics"
      ],
      "thumbnail": true,
      "preview_output": ""
    },
    {
      "id": "correct",
      "type": "calibration.apply_ccm",
      "name": "Apply color correction model",
      "parameters": {
        "model": {}
      },
      "position": [
        960,
        150
      ],
      "exposed_inputs": [
        "image",
        "mask",
        "region",
        "model"
      ],
      "exposed_outputs": [
        "image"
      ],
      "thumbnail": true,
      "preview_output": "image"
    }
