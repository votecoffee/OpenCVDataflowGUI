  "connections": [
    {
      "source": "source",
      "output": "image",
      "target": "chart",
      "input": "image"
    },
    {
      "source": "chart",
      "output": "charts",
      "target": "fit",
      "input": "patches"
    },
    {
      "source": "fit",
      "output": "model",
      "target": "correct",
      "input": "model"
    },
    {
      "source": "source",
      "output": "image",
      "target": "correct",
      "input": "image"
    }
