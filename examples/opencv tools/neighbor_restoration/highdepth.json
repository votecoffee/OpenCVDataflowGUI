    {
      "id": "restore",
      "type": "sequence.restore_neighbors",
      "name": "Restore detail from neighbors",
      "documentation": "<p>Restore a selected blurred target from sharper registered neighbors. The expected target blur is applied to each donor; channel mismatches and their configurable halo exclude detected changes. Entire scoring and blur neighborhoods must be supported. Best ties prefer batch order. Alpha stays the target's.</p><p>This is an application equivalent, not the unavailable native WeightingDeblurer. It requires upstream registration and a suitable blur model. Small, low-contrast or model-indistinguishable changes can escape the gate; accepted pixels are not proof of unchanged parts. Use raw images for critical defect decisions; qualify tolerances on representative captures. Registration and blind deconvolution are separate.</p>",
      "parameters": {
        "target_index": 1,
        "temporal_radius": 2,
        "alignment": "pixel_grid",
        "blur_model": "horizontal_box",
        "blur_size": 7,
        "blur_sigma": 1.5,
        "maximum_model_error": 0.005,
        "change_radius": 5,
        "energy_window": 5,
        "minimum_energy": 1e-06,
        "minimum_sharpness_ratio": 1.1,
        "blend": "best",
        "mix": 1.0,
        "minimum_restored_fraction": 0.0,
        "no_neighbor": "pass_through"
      },
      "position": [
        850,
        0
      ],
      "node_size": "large",
      "exposed_inputs": [
        "frames",
        "coverage",
        "mask",
        "region"
      ],
      "exposed_outputs": [
        "image",
        "restored_mask",
        "info"
      ],
      "thumbnail": true,
      "preview_output": ""
    },
