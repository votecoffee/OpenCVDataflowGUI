      "parameters": {"shape": "circle", "center": [140, 180], "radius": 20},
      "position": [320, 200],
      "exposed_inputs": ["image"],
      "exposed_outputs": ["region"],
      "thumbnail": true,
      "preview_output": "mask"
    },
    {
      "id": "second",
      "type": "region.shape",
      "name": "Second watershed seed",
      "parameters": {"shape": "circle", "center": [330, 175], "radius": 20},
      "position": [320, 400],
      "exposed_inputs": ["image"],
      "exposed_outputs": ["region"],
      "thumbnail": true,
      "preview_output": "mask"
    },
    {
      "id": "seeds",
      "type": "region.combine",
      "name": "Combine the seeds",
      "parameters": {"operation": "union"},
      "position": [640, 200],
      "exposed_inputs": ["image", "region_a", "region_b"],
      "exposed_outputs": ["mask"],
      "thumbnail": true,
      "preview_output": "mask"
    },
    {
      "id": "watershed",
      "type": "inspect.watershed",
      "name": "Create a signed label image",
      "parameters": {},
      "position": [960, 0],
      "exposed_inputs": ["image", "markers"],
      "exposed_outputs": ["labels", "regions"],
      "thumbnail": true,
      "preview_output": "labels"
    },
    {
      "id": "boundaries",
