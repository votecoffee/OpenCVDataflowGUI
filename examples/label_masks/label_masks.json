  "connections": [
    {"source": "source", "output": "image", "target": "first", "input": "image"},
    {"source": "source", "output": "image", "target": "second", "input": "image"},
    {"source": "source", "output": "image", "target": "seeds", "input": "image"},
    {"source": "first", "output": "region", "target": "seeds", "input": "region_a"},
    {"source": "second", "output": "region", "target": "seeds", "input": "region_b"},
    {"source": "source", "output": "image", "target": "watershed", "input": "image"},
    {"source": "seeds", "output": "mask", "target": "watershed", "input": "markers"},
    {"source": "watershed", "output": "labels", "target": "boundaries", "input": "image_a"},
    {"source": "watershed", "output": "labels", "target": "interiors", "input": "image"}
