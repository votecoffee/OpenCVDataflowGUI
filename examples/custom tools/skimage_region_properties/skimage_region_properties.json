    },
    {
      "source": "measure",
      "output": "labels",
      "target": "ring_mask",
      "input": "labels"
    },
    {
      "source": "rings",
      "output": "collection",
      "target": "ring_mask",
      "input": "collection"
    },
    {
      "source": "source",
      "output": "image",
      "target": "overlay",
      "input": "image"
    },
    {
      "source": "rings",
      "output": "collection",
