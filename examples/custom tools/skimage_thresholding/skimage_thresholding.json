      "id": "notes",
      "type": "layout.comment",
      "name": "scikit-image inspection example",
      "description": "Three original 16-bit material bands. Compare Multi-Otsu labels with Yen/Li and local Gaussian/Niblack/Sauvola masks. Inspect thresholds and statistics in Results. Increase class count only with a suitable bin count; bounded work prevents accidental long searches.\nOriginal synthetic fixture and graph: OpenCVDataflowGUI (MIT). No external images. Algorithm reference: scikit-image.org/docs/stable/",
      "parameters": {},
      "position": [
        0,
        -180
      ],
      "node_size": "large",
      "exposed_inputs": [],
      "exposed_outputs": [],
      "thumbnail": true,
      "preview_output": ""
    },
