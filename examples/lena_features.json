{
  "schema_version": 1,
  "blocks": [
    {
      "id": "feature_source",
      "type": "input.file",
      "name": "Lena source",
      "parameters": {
        "path": "assets/lena.jpg",
        "color_format": "bgr",
        "pixel_depth": "uint8",
        "path_base": "project"
      },
      "position": [
        0,
        0
      ],
      "exposed_inputs": [],
      "exposed_outputs": [
        "image",
        "info"
      ],
      "thumbnail": true,
      "preview_output": ""
    },
    {
      "id": "feature_gray",
      "type": "cv.convert",
      "name": "Grayscale",
      "parameters": {
        "color_format": "gray",
        "pixel_depth": "unchanged"
      },
      "position": [
        300,
        0
      ],
      "exposed_inputs": [
        "image"
      ],
      "exposed_outputs": [
        "image"
      ],
      "thumbnail": true,
      "preview_output": ""
    },
    {
      "id": "feature_clahe",
      "type": "cv.clahe",
      "name": "Local contrast",
      "parameters": {
        "clip_limit": 2.0,
        "tiles_x": 8,
        "tiles_y": 8
      },
      "position": [
        600,
        0
      ],
      "exposed_inputs": [
        "image"
      ],
      "exposed_outputs": [
        "image"
      ],
      "thumbnail": true,
      "preview_output": ""
    },
    {
      "id": "feature_corners",
      "type": "inspect.corners",
      "name": "Trackable corners",
      "parameters": {
        "max_corners": 100,
        "quality": 0.01,
        "min_distance": 10.0,
        "block_size": 3,
        "use_harris": false,
        "harris_k": 0.04,
        "gradient_size": "3"
      },
      "position": [
        900,
        0
      ],
      "exposed_inputs": [
        "image",
        "mask"
      ],
      "exposed_outputs": [
        "points",
        "count",
        "overlay"
      ],
      "thumbnail": true,
      "preview_output": "overlay"
    },
    {
      "id": "feature_histogram",
      "type": "inspect.histogram",
      "name": "Contrast histogram",
      "parameters": {
        "bins": 256,
        "range_mode": "automatic",
        "range_min": 0.0,
        "range_max": 1.0,
        "include_alpha": false
      },
      "position": [
        300,
        340
      ],
      "exposed_inputs": [
        "image"
      ],
      "exposed_outputs": [
        "histogram",
        "plot"
      ],
      "thumbnail": true,
      "preview_output": ""
    },
    {
      "id": "feature_edges",
      "type": "gapi.canny",
      "name": "Contrast edges",
      "parameters": {
        "low": 60.0,
        "high": 150.0,
        "aperture": "3",
        "l2_gradient": false
      },
      "position": [
        600,
        340
      ],
      "exposed_inputs": [
        "image"
      ],
      "exposed_outputs": [
        "image"
      ],
      "thumbnail": true,
      "preview_output": ""
    },
    {
      "id": "feature_lines",
      "type": "inspect.hough_lines",
      "name": "Line segments",
      "parameters": {
        "votes": 50,
        "min_length": 30.0,
        "max_gap": 10.0,
        "rho": 1.0,
        "theta_degrees": 1.0
      },
      "position": [
        900,
        340
      ],
      "exposed_inputs": [
        "image"
      ],
      "exposed_outputs": [
        "segments",
        "count",
        "overlay"
      ],
      "thumbnail": true,
      "preview_output": "overlay"
    }
  ],
  "connections": [
    {
      "source": "feature_source",
      "output": "image",
      "target": "feature_gray",
      "input": "image"
    },
    {
      "source": "feature_gray",
      "output": "image",
      "target": "feature_clahe",
      "input": "image"
    },
    {
      "source": "feature_clahe",
      "output": "image",
      "target": "feature_corners",
      "input": "image"
    },
    {
      "source": "feature_clahe",
      "output": "image",
      "target": "feature_histogram",
      "input": "image"
    },
    {
      "source": "feature_clahe",
      "output": "image",
      "target": "feature_edges",
      "input": "image"
    },
    {
      "source": "feature_edges",
      "output": "image",
      "target": "feature_lines",
      "input": "image"
    }
  ]
}
