      "exposed_inputs": [],
      "exposed_outputs": ["image"],
      "thumbnail": true
    },
    {
      "id": "background",
      "type": "cv.crop",
      "name": "Sample background pixels",
      "parameters": {"x": 0, "y": 0, "width": 24, "height": 14},
      "position": [330, 200],
      "exposed_inputs": ["image"],
      "exposed_outputs": ["image"],
      "thumbnail": true
    },
    {
      "id": "notch",
      "type": "cv.paste_patch",
