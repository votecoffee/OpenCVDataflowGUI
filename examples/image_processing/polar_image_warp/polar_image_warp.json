    {"source": "source", "output": "image", "target": "notch", "input": "canvas"},
    {"source": "background", "output": "image", "target": "notch", "input": "patch"},
    {"source": "notch", "output": "image", "target": "unwrap", "input": "image"},
    {"source": "unwrap", "output": "image", "target": "rewrap", "input": "image"},
    {"source": "unwrap", "output": "valid_mask", "target": "rewrap", "input": "mask"}
