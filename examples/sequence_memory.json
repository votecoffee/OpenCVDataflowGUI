      "position": [
        360,
        860
      ],
      "exposed_inputs": [
        "image",
        "mask",
        "region",
        "reset",
        "stream"
      ],
      "exposed_outputs": [
        "tracks",
        "overlay",
        "ready",
        "activations",
        "status"
      ],
      "thumbnail": true,
      "preview_output": ""
    },
    {
      "id": "sequence_image_memory",
      "type": "sequence.image_memory",
      "name": "Image memory / trained reference",
      "parameters": {
        "warmup": 3,
        "max_streams": 4,
        "max_bytes_mb": 128.0,
        "overflow": "error",
        "context_change": "reset",
        "max_gap_ms": 0.0,
        "mode": "mean",
        "freeze_after_warmup": true,
        "reference_context": "strict"
